{
  "plugins": {
    "google-antigravity-sdk": {
      "enabled": true
    }
  },
  "userSettings": {
    "artifactReviewMode": "ARTIFACT_REVIEW_MODE_ALWAYS",
    "autoExecutionPolicy": "CASCADE_COMMANDS_AUTO_EXECUTION_PROCEED_IN_SANDBOX",
    "browserJsExecutionPolicy": "BROWSER_JS_EXECUTION_POLICY_ALWAYS_ASK",
    "cliRemoteControlHostname": "raspi6",
    "conversationWidth": "CONVERSATION_WIDTH_NARROW",
    "customThemeSeedsDark": {
      "background": "#272822",
      "foregroundOverride": "#F8F8F2",
      "primary": "#F92672"
    },
    "customThemeSeedsLight": {
      "background": "#FAF4E5",
      "foregroundOverride": "#435155",
      "primary": "#CB4B16"
    },
    "enableTerminalSandbox": true,
    "globalPermissionGrants": {
      "allow": [
        "command(.)",
        "command(cat)",
        "command(cd)",
        "command(cp)",
        "command(echo)",
        "command(env)",
        "command(file)",
        "command(find)",
        "command(gh auth status)",
        "command(gh pr)",
        "command(gh run)",
        "command(git add)",
        "command(git branch)",
        "command(git checkout)",
        "command(git commit)",
        "command(git diff)",
        "command(git fetch)",
        "command(git log)",
        "command(git ls-remote)",
        "command(git ls-tree)",
        "command(git merge-base)",
        "command(git mv)",
        "command(git pull)",
        "command(git rebase)",
        "command(git remote)",
        "command(git rm)",
        "command(git show)",
        "command(git status)",
        "command(git tag)",
        "command(git worktree)",
        "command(grep)",
        "command(head)",
        "command(jq)",
        "command(ls)",
        "command(mdformat)",
        "command(mkdir)",
        "command(npm run)",
        "command(npm test)",
        "command(ping)",
        "command(ps)",
        "command(readlink)",
        "command(sort)",
        "command(source)",
        "command(stat)",
        "command(strings)",
        "command(tail)",
        "command(touch)",
        "command(tr)",
        "command(uname)",
        "command(uv)",
        "command(wc)",
        "command(whereis)",
        "command(which)",
        "read_url(antigravity.google)",
        "read_url(raw.githubusercontent.com)",
        "command(go version)",
        "command(go mod tidy)",
        "command(go vet)",
        "command(go doc)",
        "command(make all)",
        "command(diff)"
      ]
    },
    "nonWorkspaceFileAccessPolicy": "AGENT_SETTING_POLICY_ASK",
    "queuedMessageDeliveryStrategy": "MESSAGE_DELIVERY_STRATEGY_NEXT_INVOCATION",
    "remoteControlEnabled": true,
    "remoteControlHostname": "raspi6",
    "themeMode": "THEME_MODE_INHERIT",
    "verboseAgentChat": false
  }
}