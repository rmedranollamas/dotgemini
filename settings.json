{
  "context": {
    "fileName": [
      "GEMINI.md",
      "AGENTS.md"
    ],
    "loadFromIncludeDirectories": true
  },
  "model": {
    "summarizeToolOutput": {
      "ShellTool": {
        "tokenBudget": 100000
      }
    },
    "chatCompression": {
      "contextPercentageThreshold": 0.4
    }
  },
  "tools": {
    "allowed": [
      "list_directory",
      "read_file",
      "read_many_files",
      "save_memory",
      "ShellTool(cat)",
      "ShellTool(diff)",
      "ShellTool(find)",
      "ShellTool(gh)",
      "ShellTool(git)",
      "ShellTool(grep)",
      "ShellTool(ls)",
      "ShellTool(mdformat)",
      "ShellTool(uv)",
      "ShellTool(ruff)",
      "ShellTool(whoami)",
      "ShellTool(mkdir)",
      "ShellTool(touch)",
      "ShellTool(sed)",
      "ShellTool(head)"
    ],
    "shell": {
      "showColor": true
    },
    "truncateToolOutputLines": 10000
  },
  "general": {
    "checkpointing": {
      "enabled": true
    },
    "disableAutoUpdate": true,
    "disableUpdateNag": true,
    "enablePromptCompletion": false
  },
  "ide": {
    "hasSeenNudge": true,
    "enabled": false
  },
  "ui": {
    "hideTips": true,
    "footer": {
      "hideSandboxStatus": true
    },
    "showLineNumbers": true,
    "showCitations": true,
    "theme": "ANSI",
    "showStatusInTitle": true,
    "useFullWidth": true
  },
  "useSmartEdit": true,
  "experimental": {
    "useModelRouter": true
  },
  "security": {
    "auth": {
      "selectedType": "gemini-api-key"
    }
  }
}
