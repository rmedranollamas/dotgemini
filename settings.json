{
  "general": {
    "checkpointing": {
      "enabled": true
    },
    "enableAutoUpdate": false,
    "enableAutoUpdateNotification": false,
    "enablePromptCompletion": false,
    "preferredEditor": "emacs",
    "retryFetchErrors": true,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d"
    },
    "defaultApprovalMode": "auto_edit",
    "plan": {
      "modelRouting": true
    },
    "maxAttempts": 10
  },
  "ui": {
    "hideTips": true,
    "footer": {
      "hideSandboxStatus": true,
      "hideContextPercentage": false,
      "hideCWD": false
    },
    "showLineNumbers": true,
    "showCitations": true,
    "showStatusInTitle": true,
    "showMemoryUsage": false,
    "useAlternateBuffer": true,
    "incrementalRendering": true,
    "hideContextSummary": true,
    "showModelInfoInChat": true,
    "hideWindowTitle": false,
    "showHomeDirectoryWarning": false,
    "showUserIdentity": true,
    "autoThemeSwitching": false,
    "useBackgroundColor": true,
    "inlineThinkingMode": "off",
    "showShortcutsHint": false,
    "theme": "Solarized Dark",
    "showSpinner": false
  },
  "ide": {
    "hasSeenNudge": true,
    "enabled": false
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "model": {
    "summarizeToolOutput": {
      "run_shell_command": {
        "tokenBudget": 20000
      }
    },
    "compressionThreshold": 0.23,
    "skipNextSpeakerCheck": false,
    "disableLoopDetection": false,
    "name": "auto-gemini-3"
  },
  "context": {
    "fileName": [
      "GEMINI.md",
      "AGENTS.md"
    ],
    "includeDirectories": [
      "~/.gemini"
    ],
    "loadMemoryFromIncludeDirectories": true,
    "includeDirectoryTree": true
  },
  "tools": {
    "shell": {
      "showColor": true,
      "enableInteractiveShell": true,
      "enableShellOutputEfficiency": true
    },
    "truncateToolOutputThreshold": 20000,
    "useRipgrep": true,
    "disableLLMCorrection": false
  },
  "useWriteTodos": true,
  "skills": {
    "enabled": true
  },
  "security": {
    "disableYoloMode": false,
    "enablePermanentToolApproval": true,
    "folderTrust": {
      "enabled": true
    },
    "environmentVariableRedaction": {
      "enabled": true
    }
  },
  "advanced": {
    "autoConfigureMemory": true
  },
  "experimental": {
    "toolOutputMasking": {
      "enabled": true,
      "toolProtectionThreshold": 50000,
      "minPrunableTokensThreshold": 30000,
      "protectLatestTurn": true
    },
    "enableAgents": true,
    "extensionManagement": true,
    "extensionConfig": true,
    "extensionReloading": true,
    "jitContext": true,
    "useOSC52Paste": true,
    "useOSC52Copy": true,
    "plan": true,
    "modelSteering": true,
    "directWebFetch": true
  },
  "hooksConfig": {
    "enabled": true,
    "notifications": true
  },
  "hooks": {
    "BeforeTool": [],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "name": "md-format",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-mdformat.sh",
            "description": "Markdown formatting check.",
            "timeout": 5000
          },
          {
            "name": "toml-validator",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-toml.sh",
            "description": "TOML syntax validation.",
            "timeout": 5000
          },
          {
            "name": "ruff-lint",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-ruff.sh",
            "description": "Linting and formatting check.",
            "timeout": 5000
          },
          {
            "name": "ty-check",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-ty.sh",
            "description": "Python type checking.",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "agents": {
    "overrides": {
      "codebase_investigator": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 20
        }
      },
      "cli_help": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 5
        }
      },
      "architect": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "implementer": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "reviewer": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "verifier": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "generalist": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 20
        }
      },
      "planner": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 20
        }
      }
    }
  }
}