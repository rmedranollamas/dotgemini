{
  "context": {
    "fileName": [
      "GEMINI.md",
      "AGENTS.md"
    ],
    "loadFromIncludeDirectories": true,
    "loadMemoryFromIncludeDirectories": true
  },
  "model": {
    "summarizeToolOutput": {
      "run_shell_command": {
        "tokenBudget": 15000
      }
    },
    "compressionThreshold": 0.35,
    "skipNextSpeakerCheck": false
  },
  "hooks": {
    "enabled": true,
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "name": "toml-validator",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-toml.sh",
            "description": "TOML syntax validation.",
            "timeout": 5000
          },
          {
            "name": "ruff-lint",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-ruff.sh",
            "description": "Linting and formatting check.",
            "timeout": 5000
          },
          {
            "name": "ty-check",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-ty.sh",
            "description": "Python type checking.",
            "timeout": 5000
          }
        ]
      }
    ],
    "notifications": true
  },
  "tools": {
    "allowed": [
      "activate_skill",
      "delegate_to_agent",
      "google_web_search",
      "list_directory",
      "read_file",
      "glob",
      "search_file_content",
      "run_shell_command(awk)",
      "run_shell_command(base64)",
      "run_shell_command(cat)",
      "run_shell_command(chmod)",
      "run_shell_command(column)",
      "run_shell_command(cp)",
      "run_shell_command(curl)",
      "run_shell_command(date)",
      "run_shell_command(df)",
      "run_shell_command(diff)",
      "run_shell_command(du)",
      "run_shell_command(env)",
      "run_shell_command(file)",
      "run_shell_command(find)",
      "run_shell_command(free)",
      "run_shell_command(gh)",
      "run_shell_command(git)",
      "run_shell_command(grep)",
      "run_shell_command(head)",
      "run_shell_command(hostname)",
      "run_shell_command(id)",
      "run_shell_command(jq)",
      "run_shell_command(ls)",
      "run_shell_command(lscpu)",
      "run_shell_command(mdformat)",
      "run_shell_command(mkdir)",
      "run_shell_command(mv)",
      "run_shell_command(npm)",
      "run_shell_command(npx)",
      "run_shell_command(php)",
      "run_shell_command(ps)",
      "run_shell_command(pwd)",
      "run_shell_command(python)",
      "run_shell_command(python3)",
      "run_shell_command(ruff)",
      "run_shell_command(sed)",
      "run_shell_command(sort)",
      "run_shell_command(sqlite3)",
      "run_shell_command(stat)",
      "run_shell_command(tail)",
      "run_shell_command(tar)",
      "run_shell_command(touch)",
      "run_shell_command(tr)",
      "run_shell_command(tree)",
      "run_shell_command(ty)",
      "run_shell_command(uniq)",
      "run_shell_command(unzip)",
      "run_shell_command(uptime)",
      "run_shell_command(uv)",
      "run_shell_command(wc)",
      "run_shell_command(which)",
      "run_shell_command(whoami)",
      "save_memory",
      "web_fetch",
      "write_todos"
    ],
    "shell": {
      "showColor": true,
      "enableInteractiveShell": true
    },
    "truncateToolOutputLines": 500,
    "truncateToolOutputThreshold": 30000,
    "autoAccept": true,
    "enableMessageBusIntegration": true,
    "enableHooks": true
  },
  "general": {
    "checkpointing": {
      "enabled": true
    },
    "disableAutoUpdate": true,
    "disableUpdateNag": true,
    "enablePromptCompletion": false,
    "retryFetchErrors": true,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d"
    },
    "previewFeatures": true
  },
  "ide": {
    "hasSeenNudge": true,
    "enabled": false
  },
  "ui": {
    "hideTips": true,
    "footer": {
      "hideSandboxStatus": true,
      "hideContextPercentage": false
    },
    "showLineNumbers": true,
    "showCitations": true,
    "theme": "Monokai Classic",
    "customThemes": {
      "Monokai Classic": {
        "name": "Monokai Classic",
        "type": "custom",
        "Background": "#272822",
        "Foreground": "#FDFFF1",
        "LightBlue": "#66D9EF",
        "AccentBlue": "#1E90FF",
        "AccentPurple": "#AE81FF",
        "AccentCyan": "#66D9EF",
        "AccentGreen": "#A6E22E",
        "AccentYellow": "#E6DB74",
        "AccentRed": "#F92672",
        "Comment": "#6E7066",
        "Gray": "#6E7066",
        "DiffAdded": "#4b6616",
        "DiffRemoved": "#4a1b1b"
      }
    },
    "showStatusInTitle": false,
    "useFullWidth": true,
    "showMemoryUsage": false,
    "useAlternateBuffer": false,
    "incrementalRendering": true,
    "hideContextSummary": true,
    "showModelInfoInChat": false,
    "hideWindowTitle": true
  },
  "useSmartEdit": true,
  "useWriteTodos": true,
  "experimental": {
    "enableAgents": true,
    "extensionManagement": true,
    "extensionReloading": true,
    "jitContext": true,
    "skills": true,
    "useModelRouter": true,
    "codebaseInvestigatorSettings": {
      "enabled": true,
      "maxNumTurns": 30,
      "thinkingBudget": -1
    },
    "cliHelpAgentSettings": {
      "enabled": true
    },
    "useOSC52Paste": true
  },
  "security": {
    "disableYoloMode": true,
    "enablePermanentToolApproval": true,
    "folderTrust": {
      "enabled": true
    },
    "environmentVariableRedaction": {
      "enabled": true
    }
  },
  "advanced": {
    "autoConfigureMemory": true
  },
  "privacy": {
    "usageStatisticsEnabled": false
  }
}