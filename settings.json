{
  "context": {
    "fileName": [
      "GEMINI.md"
    ],
    "loadFromIncludeDirectories": true,
    "loadMemoryFromIncludeDirectories": true
  },
  "model": {
    "summarizeToolOutput": {
      "ShellTool": {
        "tokenBudget": 100000
      }
    },
    "chatCompression": {
      "contextPercentageThreshold": 0.4
    }
  },
  "tools": {
    "allowed": [
      "list_directory",
      "read_file",
      "save_memory",
      "ShellTool(cat)",
      "ShellTool(diff)",
      "ShellTool(find)",
      "ShellTool(gh)",
      "ShellTool(git)",
      "ShellTool(grep)",
      "ShellTool(ls)",
      "ShellTool(mdformat)",
      "ShellTool(uv)",
      "ShellTool(ruff)",
      "ShellTool(whoami)",
      "ShellTool(mkdir)",
      "ShellTool(touch)",
      "ShellTool(sed)",
      "ShellTool(pwd)",
      "ShellTool(head)"
    ],
    "shell": {
      "showColor": true
    },
    "truncateToolOutputLines": 1000,
    "truncateToolOutputThreshold": 100000,
    "autoAccept": true
  },
  "general": {
    "checkpointing": {
      "enabled": true
    },
    "disableAutoUpdate": true,
    "disableUpdateNag": true,
    "enablePromptCompletion": false,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d"
    }
  },
  "ide": {
    "hasSeenNudge": true,
    "enabled": false
  },
  "ui": {
    "hideTips": true,
    "footer": {
      "hideSandboxStatus": true
    },
    "showLineNumbers": true,
    "showCitations": true,
    "theme": "ANSI",
    "showStatusInTitle": true,
    "useFullWidth": true,
    "showMemoryUsage": false,
    "useAlternateBuffer": true
  },
  "useSmartEdit": true,
  "useWriteTodos": true,
  "experimental": {
    "useModelRouter": true,
    "codebaseInvestigatorSettings": {
      "enabled": true,
      "codebaseInvestigatorSettings": 16384
    }
  },
  "security": {
    "disableYoloMode": true
  }
}
