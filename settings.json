{
  "$schema": "./settings.schema.json",
  "general": {
    "checkpointing": {
      "enabled": true
    },
    "enableAutoUpdate": false,
    "enableAutoUpdateNotification": false,
    "enablePromptCompletion": false,
    "preferredEditor": "emacs",
    "retryFetchErrors": true,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d"
    },
    "previewFeatures": true,
    "defaultApprovalMode": "auto_edit"
  },
  "ui": {
    "hideTips": true,
    "footer": {
      "hideSandboxStatus": true,
      "hideContextPercentage": false,
      "hideCWD": false
    },
    "showLineNumbers": true,
    "showCitations": true,
    "theme": "Solarized Dark",
    "customThemes": {
      "Solarized Dark": {
        "name": "Solarized Dark",
        "type": "custom",
        "Background": "#002b36",
        "Foreground": "#839496",
        "LightBlue": "#268bd2",
        "AccentBlue": "#268bd2",
        "AccentPurple": "#6c71c4",
        "AccentCyan": "#2aa198",
        "AccentGreen": "#859900",
        "AccentYellow": "#d0b000",
        "AccentRed": "#dc322f",
        "DiffAdded": "#859900",
        "DiffRemoved": "#dc322f",
        "Comment": "#586e75",
        "Gray": "#586e75",
        "DarkGray": "#073642",
        "GradientColors": [
          "#002b36",
          "#073642"
        ],
        "text": {
          "primary": "#839496",
          "secondary": "#586e75",
          "accent": "#268bd2",
          "link": "#268bd2"
        },
        "background": {
          "primary": "#002b36",
          "diff": {
            "added": "#00382f",
            "removed": "#3d0115"
          }
        },
        "border": {
          "default": "#073642",
          "focused": "#586e75"
        },
        "ui": {
          "comment": "#586e75",
          "symbol": "#93a1a1",
          "gradient": [
            "#002b36",
            "#073642"
          ]
        },
        "status": {
          "success": "#859900",
          "warning": "#d0b000",
          "error": "#dc322f"
        }
      },
      "Solarized Light": {
        "name": "Solarized Light",
        "type": "custom",
        "Background": "#fdf6e3",
        "Foreground": "#657b83",
        "LightBlue": "#268bd2",
        "AccentBlue": "#268bd2",
        "AccentPurple": "#6c71c4",
        "AccentCyan": "#2aa198",
        "AccentGreen": "#859900",
        "AccentYellow": "#d0b000",
        "AccentRed": "#dc322f",
        "DiffAdded": "#859900",
        "DiffRemoved": "#dc322f",
        "Comment": "#93a1a1",
        "Gray": "#93a1a1",
        "DarkGray": "#eee8d5",
        "GradientColors": [
          "#fdf6e3",
          "#eee8d5"
        ],
        "text": {
          "primary": "#657b83",
          "secondary": "#93a1a1",
          "accent": "#268bd2",
          "link": "#268bd2"
        },
        "background": {
          "primary": "#fdf6e3",
          "diff": {
            "added": "#d7f2d7",
            "removed": "#f2d7d7"
          }
        },
        "border": {
          "default": "#eee8d5",
          "focused": "#93a1a1"
        },
        "ui": {
          "comment": "#93a1a1",
          "symbol": "#586e75",
          "gradient": [
            "#fdf6e3",
            "#eee8d5"
          ]
        },
        "status": {
          "success": "#859900",
          "warning": "#d0b000",
          "error": "#dc322f"
        }
      }
    },
    "showStatusInTitle": true,
    "showMemoryUsage": false,
    "useAlternateBuffer": true,
    "incrementalRendering": true,
    "hideContextSummary": true,
    "showModelInfoInChat": false,
    "hideWindowTitle": false,
    "showHomeDirectoryWarning": false,
    "showUserIdentity": true,
    "autoThemeSwitching": false,
    "useBackgroundColor": false
  },
  "ide": {
    "hasSeenNudge": true,
    "enabled": false
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "model": {
    "summarizeToolOutput": {
      "run_shell_command": {
        "tokenBudget": 20000
      }
    },
    "compressionThreshold": 0.25,
    "skipNextSpeakerCheck": false,
    "name": "gemini-3-flash-preview",
    "disableLoopDetection": true
  },
  "context": {
    "fileName": [
      "GEMINI.md",
      "AGENTS.md"
    ],
    "loadMemoryFromIncludeDirectories": true
  },
  "tools": {
    "shell": {
      "showColor": true,
      "enableInteractiveShell": true,
      "enableShellOutputEfficiency": true
    },
    "truncateToolOutputThreshold": 20000,
    "useRipgrep": true,
    "allowed": [
      "ask_user",
      "activate_skill",
      "delegate_to_agent",
      "google_web_search",
      "list_directory",
      "read_file",
      "glob",
      "search_file_content",
      "save_memory",
      "web_fetch",
      "write_todos",
      "planner",
      "codebase_investigator",
      "cli_help",
      "generalist",
      "architect",
      "implementer",
      "reviewer",
      "verifier",
      "exit_plan_mode",
      "enter_plan_mode"
    ],
    "disableLLMCorrection": false,
    "approvalMode": "auto_edit"
  },
  "useWriteTodos": true,
  "skills": {
    "enabled": true
  },
  "security": {
    "disableYoloMode": false,
    "enablePermanentToolApproval": true,
    "folderTrust": {
      "enabled": true
    },
    "environmentVariableRedaction": {
      "enabled": true
    }
  },
  "advanced": {
    "autoConfigureMemory": true
  },
  "experimental": {
    "toolOutputMasking": {
      "enabled": true,
      "toolProtectionThreshold": 50000,
      "minPrunableTokensThreshold": 30000,
      "protectLatestTurn": true
    },
    "enableAgents": true,
    "extensionManagement": true,
    "extensionConfig": true,
    "extensionReloading": true,
    "jitContext": true,
    "useOSC52Paste": true,
    "plan": true
  },
  "hooksConfig": {
    "enabled": true,
    "notifications": true
  },
  "hooks": {
    "BeforeTool": [],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "name": "md-format",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-mdformat.sh",
            "description": "Markdown formatting check.",
            "timeout": 5000
          },
          {
            "name": "toml-validator",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-toml.sh",
            "description": "TOML syntax validation.",
            "timeout": 5000
          },
          {
            "name": "ruff-lint",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-ruff.sh",
            "description": "Linting and formatting check.",
            "timeout": 5000
          },
          {
            "name": "ty-check",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-ty.sh",
            "description": "Python type checking.",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "agents": {
    "overrides": {
      "codebase_investigator": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 30,
          "maxTimeMinutes": 5
        }
      },
      "cli_help": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 1
        }
      },
      "architect": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "implementer": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "reviewer": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "verifier": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "generalist": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 20
        }
      },
      "planner": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 20
        }
      }
    }
  }
}
