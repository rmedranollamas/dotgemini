{
  "general": {
    "checkpointing": {
      "enabled": true
    },
    "enableAutoUpdate": false,
    "enableAutoUpdateNotification": false,
    "enablePromptCompletion": false,
    "preferredEditor": "emacs",
    "retryFetchErrors": true,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d"
    },
    "previewFeatures": true
  },
  "ui": {
    "hideTips": true,
    "footer": {
      "hideSandboxStatus": true,
      "hideContextPercentage": false,
      "hideCWD": false
    },
    "showLineNumbers": true,
    "showCitations": true,
    "theme": "Monokai",
    "customThemes": {
      "Monokai": {
        "name": "Monokai",
        "type": "custom",
        "Background": "#272822",
        "Foreground": "#FDFFF1",
        "LightBlue": "#66D9EF",
        "AccentBlue": "#1E90FF",
        "AccentPurple": "#AE81FF",
        "AccentCyan": "#66D9EF",
        "AccentGreen": "#A6E22E",
        "AccentYellow": "#E6DB74",
        "AccentRed": "#F92672",
        "Comment": "#6E7066",
        "Gray": "#6E7066",
        "DiffAdded": "#4b6616",
        "DiffRemoved": "#4a1b1b"
      }
    },
    "showStatusInTitle": true,
    "useFullWidth": true,
    "showMemoryUsage": false,
    "useAlternateBuffer": true,
    "incrementalRendering": true,
    "hideContextSummary": true,
    "showModelInfoInChat": false,
    "hideWindowTitle": false,
    "showHomeDirectoryWarning": false
  },
  "ide": {
    "hasSeenNudge": true,
    "enabled": false
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "model": {
    "summarizeToolOutput": {
      "run_shell_command": {
        "tokenBudget": 5000
      }
    },
    "compressionThreshold": 0.25,
    "skipNextSpeakerCheck": false,
    "name": "gemini-3-flash-preview"
  },
  "context": {
    "fileName": [
      "GEMINI.md"
    ],
    "loadMemoryFromIncludeDirectories": true
  },
  "tools": {
    "shell": {
      "showColor": true,
      "enableInteractiveShell": true,
      "enableShellOutputEfficiency": true
    },
    "truncateToolOutputLines": 250,
    "truncateToolOutputThreshold": 20000,
    "autoAccept": true,
    "enableHooks": true,
    "allowed": [
      "ask_user",
      "activate_skill",
      "delegate_to_agent",
      "google_web_search",
      "list_directory",
      "read_file",
      "glob",
      "search_file_content",
      "save_memory",
      "web_fetch",
      "write_todos",
      "codebase_investigator",
      "cli_help",
      "generalist",
      "architect",
      "implementer",
      "reviewer",
      "verifier",
      "exit_plan_mode",
      "enter_plan_mode"
    ],
    "disableLLMCorrection": false,
    "approvalMode": "auto_edit"
  },
  "useWriteTodos": true,
  "security": {
    "disableYoloMode": false,
    "enablePermanentToolApproval": true,
    "folderTrust": {
      "enabled": true
    },
    "environmentVariableRedaction": {
      "enabled": true
    }
  },
  "advanced": {
    "autoConfigureMemory": true
  },
  "experimental": {
    "enableAgents": true,
    "extensionManagement": true,
    "extensionConfig": true,
    "enableExtensionAgents": true,
    "extensionReloading": true,
    "jitContext": true,
    "skills": true,
    "codebaseInvestigatorSettings": {
      "enabled": true,
      "maxNumTurns": 30,
      "thinkingBudget": -1
    },
    "cliHelpAgentSettings": {
      "enabled": true
    },
    "useOSC52Paste": true,
    "plan": true
  },
  "hooksConfig": {
    "enabled": true,
    "notifications": true
  },
  "hooks": {
    "BeforeTool": [],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "name": "md-format",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-mdformat.sh",
            "description": "Markdown formatting check.",
            "timeout": 5000
          },
          {
            "name": "toml-validator",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-toml.sh",
            "description": "TOML syntax validation.",
            "timeout": 5000
          },
          {
            "name": "ruff-lint",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-ruff.sh",
            "description": "Linting and formatting check.",
            "timeout": 5000
          },
          {
            "name": "ty-check",
            "type": "command",
            "command": "$HOME/.gemini/hooks/run-ty.sh",
            "description": "Python type checking.",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "agents": {
    "overrides": {
      "codebase_investigator": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 30,
          "maxTimeMinutes": 5
        },
        "modelConfig": {
          "generateContentConfig": {
            "thinkingConfig": {
              "thinkingBudget": -1
            }
          }
        }
      },
      "cli_help": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 1
        }
      },
      "architect": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "implementer": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "reviewer": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "verifier": {
        "enabled": true,
        "runConfig": {
          "maxTimeMinutes": 20,
          "maxTurns": 100
        }
      },
      "generalist": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 20
        }
      }
    }
  }
}
