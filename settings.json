{
  "general": {
    "checkpointing": {
      "enabled": true
    },
    "enableAutoUpdate": false,
    "enableAutoUpdateNotification": false,
    "preferredEditor": "emacs",
    "retryFetchErrors": true,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "90d"
    },
    "defaultApprovalMode": "auto_edit",
    "plan": {
      "modelRouting": true,
      "enabled": true
    },
    "maxAttempts": 10,
    "topicUpdateNarration": true,
    "enableNotifications": true
  },
  "ui": {
    "hideTips": false,
    "footer": {
      "hideSandboxStatus": true,
      "hideContextPercentage": false,
      "hideCWD": false,
      "showLabels": false,
      "items": [
        "workspace",
        "git-branch",
        "context-used",
        "token-count"
      ]
    },
    "showLineNumbers": true,
    "showCitations": true,
    "showStatusInTitle": true,
    "showMemoryUsage": false,
    "useAlternateBuffer": true,
    "incrementalRendering": true,
    "hideContextSummary": false,
    "showModelInfoInChat": true,
    "hideWindowTitle": false,
    "showHomeDirectoryWarning": false,
    "showUserIdentity": true,
    "autoThemeSwitching": true,
    "useBackgroundColor": true,
    "inlineThinkingMode": "off",
    "showShortcutsHint": false,
    "theme": "ANSI",
    "showSpinner": false,
    "loadingPhrases": "off",
    "errorVerbosity": "low",
    "escapePastedAtSymbols": true,
    "terminalBuffer": true,
    "dynamicWindowTitle": true,
    "compactToolOutput": true
  },
  "ide": {
    "hasSeenNudge": true,
    "enabled": false
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "billing": {
    "overageStrategy": "ask"
  },
  "model": {
    "summarizeToolOutput": {
      "run_shell_command": {
        "tokenBudget": 64000
      }
    },
    "compressionThreshold": 0.128,
    "skipNextSpeakerCheck": false,
    "disableLoopDetection": false,
    "name": "gemini-3.5-flash"
  },
  "agents": {
    "overrides": {
      "codebase_investigator": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 20
        }
      },
      "cli_help": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 50,
          "maxTimeMinutes": 10
        }
      },
      "generalist": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 20
        }
      }
    },
    "browser": {
      "blockFileUploads": true,
      "confirmSensitiveActions": true
    }
  },
  "context": {
    "fileName": [
      "GEMINI.md",
      "AGENTS.md"
    ],
    "includeDirectories": [
      "~/.gemini"
    ],
    "loadMemoryFromIncludeDirectories": true,
    "includeDirectoryTree": false,
    "fileFiltering": {
      "enableFileWatcher": true
    }
  },
  "tools": {
    "shell": {
      "showColor": true,
      "enableInteractiveShell": false,
      "enableShellOutputEfficiency": true,
      "backgroundCompletionBehavior": "inject"
    },
    "truncateToolOutputThreshold": 32000,
    "useRipgrep": true,
    "disableLLMCorrection": false,
    "sandboxNetworkAccess": true
  },
  "useWriteTodos": true,
  "security": {
    "disableYoloMode": false,
    "enablePermanentToolApproval": true,
    "folderTrust": {
      "enabled": true
    },
    "environmentVariableRedaction": {
      "enabled": true
    },
    "auth": {
      "selectedType": "gemini-api-key"
    },
    "autoAddToPolicyByDefault": true,
    "enableConseca": false,
    "toolSandboxing": false
  },
  "advanced": {
    "autoConfigureMemory": true
  },
  "experimental": {
    "enableAgents": true,
    "extensionManagement": true,
    "extensionConfig": true,
    "extensionRegistry": true,
    "extensionReloading": true,
    "useOSC52Paste": true,
    "useOSC52Copy": true,
    "modelSteering": true,
    "directWebFetch": true,
    "topicUpdateNarration": true,
    "worktrees": true,
    "autoMemory": true,
    "generalistProfile": false,
    "contextManagement": false,
    "taskTracker": true,
    "voice": {
      "backend": "gemini-live"
    },
    "gemma": true
  },
  "skills": {
    "enabled": true
  },
  "hooksConfig": {
    "enabled": true,
    "notifications": true
  },
  "hooks": {
    "BeforeTool": [],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "name": "gofmt",
            "type": "command",
            "command": "/home/pi/.gemini/hooks/run-gofmt.sh",
            "description": "Go formatting check.",
            "timeout": 5000
          },
          {
            "name": "govet",
            "type": "command",
            "command": "/home/pi/.gemini/hooks/run-govet.sh",
            "description": "Go static analysis.",
            "timeout": 5000
          },
          {
            "name": "json-validator",
            "type": "command",
            "command": "/home/pi/.gemini/hooks/run-json.sh",
            "description": "JSON syntax and formatting.",
            "timeout": 5000
          },
          {
            "name": "mdformat",
            "type": "command",
            "command": "/home/pi/.gemini/hooks/run-mdformat.sh",
            "description": "Markdown formatting.",
            "timeout": 5000
          },
          {
            "name": "ruff-lint",
            "type": "command",
            "command": "/home/pi/.gemini/hooks/run-ruff.sh",
            "description": "Python linting and formatting.",
            "timeout": 5000
          },
          {
            "name": "shell-validator",
            "type": "command",
            "command": "/home/pi/.gemini/hooks/run-shell.sh",
            "description": "Shell script syntax check.",
            "timeout": 5000
          },
          {
            "name": "toml-validator",
            "type": "command",
            "command": "/home/pi/.gemini/hooks/run-toml.sh",
            "description": "TOML syntax validation.",
            "timeout": 5000
          },
          {
            "name": "ty-check",
            "type": "command",
            "command": "/home/pi/.gemini/hooks/run-ty.sh",
            "description": "Python type checking.",
            "timeout": 5000
          },
          {
            "name": "yaml-validator",
            "type": "command",
            "command": "/home/pi/.gemini/hooks/run-yaml.sh",
            "description": "YAML syntax validation.",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "contextManagement": {
    "tools": {
      "outputMasking": {
        "protectionThresholdTokens": 32000,
        "minPrunableThresholdTokens": 16000,
        "protectLatestTurn": true
      }
    },
    "historyWindow": {
      "maxTokens": 100000,
      "retainedTokens": 32000
    }
  }
}