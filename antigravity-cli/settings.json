    "command": "",
    "enabled": false
  },
  "toolPermission": "proceed-in-sandbox",
  "trustedWorkspaces": [
    "/home/pi",
    "/home/pi/.gemini",
    "/home/pi/exiftool_gps",
    "/home/pi/research-cli",
    "/home/pi/x",
    "/home/pi/osint",
    "/home/pi/swiss-bank"
  ],
  "useTerminalCursor": true,
  "verbosity": "low"
}
