{
  "agentMode": "accept-edits",
  "artifactReviewPolicy": "agent-decides",
  "colorScheme": "dark",
  "editor": "emacsclient",
  "enableTerminalSandbox": true,
  "historySize": 10000,
  "model": "Gemini 3.8 Flash (Medium)",
  "notifications": true,
  "pickerGrouping": "grouped",
